{
  "name": "ercot-mcp",
  "version": "1.0.0",
  "description": "MCP server exposing ERCOT public grid data (prices, load, generation, congestion) as tools for LLM agents. Base AITX Talent Hackathon, Track 1 - Open Grid Data.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ercot-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "dashboard": "npm run build && node dist/dashboard-server.js",
    "test": "tsc && node --test \"dist/**/*.test.js\""
  },
  "keywords": [
    "base",
    "ercot",
    "mcp",
    "hackathon",
    "grid-data"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "dotenv": "^18.0.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
